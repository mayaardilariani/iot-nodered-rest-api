  },
  {
    "id": "cors_resp",
    "type": "function",
    "z": "flow_api",
    "name": "CORS Headers",
    "func": "msg.statusCode = 204;\nmsg.payload = '';\nmsg.headers = {\n    'Access-Control-Allow-Origin': '*',\n    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',\n    'Access-Control-Allow-Headers': 'Content-Type'\n};\nreturn msg;",
    "outputs": 1,
    "x": 380,
    "y": 440,
    "wires": [["cors_http_resp"]]
  },
