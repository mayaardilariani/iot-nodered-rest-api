    "y": 200,
    "wires": [["resp_suhu"]]
  },
  {
    "id": "resp_suhu",
    "type": "function",
    "z": "flow_api",
    "name": "Build Response Suhu",
    "func": "var data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nmsg.payload = {\n    status: 'success',\n    data: data,\n    server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "outputs": 1,
    "x": 410,
    "y": 200,
    "wires": [["http_resp_suhu"]]
  },
  {
    "id": "http_resp_suhu",
    "type": "http response",
    "z": "flow_api",
    "name": "",
    "statusCode": "200",
    "headers": {},
    "x": 640,
    "y": 200,
    "wires": []
  },
  {
    "id": "http_get_history",
    "type": "http in",
    "z": "flow_api",
    "name": "GET /api/history",
    "url": "/api/history",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 180,
    "y": 280,
    "wires": [["resp_history"]]
  },
  {
    "id": "resp_history",
    "type": "function",
    "z": "flow_api",
    "name": "Build Response History",
    "func": "var history = flow.get('history') || [];\nmsg.payload = {\n    status: 'success',\n    count: history.length,\n    data: history\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "outputs": 1,
    "x": 410,
    "y": 280,
    "wires": [["http_resp_history"]]
  },
  {
    "id": "http_resp_history",
    "type": "http response",
    "z": "flow_api",
    "name": "",
    "statusCode": "200",
    "headers": {},
    "x": 640,
    "y": 280,
    "wires": []
  },
  {
    "id": "http_post_kontrol",
    "type": "http in",
    "z": "flow_api",
    "name": "POST /api/kontrol",
    "url": "/api/kontrol",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 180,
    "y": 360,
    "wires": [["proc_kontrol"]]
  },
  {
    "id": "proc_kontrol",
    "type": "function",
    "z": "flow_api",
    "name": "Validasi & Publish",
    "func": "var body = msg.payload;\nif (!body || !body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null];\n}\n\n// Publish ke MQTT\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, mqttMsg];",
    "outputs": 2,
    "x": 400,
    "y": 360,
    "wires": [["http_resp_kontrol"], ["mqtt_publish_kontrol"]]
  },
  {
    "id": "http_resp_kontrol",
    "type": "http response",
    "z": "flow_api",
    "name": "",
    "x": 620,
    "y": 340,
    "wires": []
  },
  {
    "id": "mqtt_publish_kontrol",
    "type": "mqtt out",
    "z": "flow_api",
    "name": "Publish Kontrol",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "mqtt_broker_config",
    "x": 630,
    "y": 400,
    "wires": []
  },
  {
