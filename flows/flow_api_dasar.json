[
  {
    "id": "flow_api",
    "type": "tab",
    "label": "REST API IoT",
    "disabled": false,
    "info": ""
  },
  {
    "id": "mqtt_broker_config",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-backend",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4"
  },
  {
    "id": "mqtt_sensor_in",
    "type": "mqtt in",
    "z": "flow_api",
    "name": "Subscribe Sensor",
    "topic": "iot/sensor",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "x": 170,
    "y": 100,
    "wires": [["store_sensor"]]
  },
  {
    "id": "store_sensor",
    "type": "function",
    "z": "flow_api",
    "name": "Simpan Data Sensor",
    "func": "// Simpan ke context flow\nvar data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// Simpan history (max 50 data)\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nreturn msg;",
    "outputs": 1,
    "x": 410,
    "y": 100,
    "wires": [["debug_sensor"]]
  },
  {
    "id": "debug_sensor",
    "type": "debug",
    "z": "flow_api",
    "name": "Log Sensor",
    "active": true,
    "complete": "payload",
    "x": 620,
    "y": 100,
    "wires": []
  },
  {
    "id": "http_get_suhu",
    "type": "http in",
    "z": "flow_api",
    "name": "GET /api/suhu",
    "url": "/api/suhu",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
